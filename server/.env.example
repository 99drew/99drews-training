# Copie para .env (local) ou configure como Environment Variables no projeto Vercel.

# Gerado com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seuemail@example.com

# Upstash Redis (guarda as subscriptions) — crie um banco free em https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash QStash (agenda o envio do push no horário certo) — mesma conta Upstash
QSTASH_TOKEN=

# URL pública deste servidor depois de implantado (ex: https://treino-push.vercel.app)
PUBLIC_SERVER_URL=

# Origem do app que pode chamar essas rotas (ex: https://99drew.github.io)
ALLOWED_ORIGIN=https://99drew.github.io
